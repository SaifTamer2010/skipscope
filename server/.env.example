# Server Environment Variables Template
# Copy this to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration (if using custom JWT)
JWT_SECRET=your-jwt-secret

# Notification System
SLACK_WEBHOOK_URL=your-error-webhook
SLACK_WEBHOOK_URL_USERS=your-user-webhook
SLACK_WEBHOOK_URL_SUPPORT=your-support-webhook
# Change this to a strong, random secret in production
WEBHOOK_SECRET=your-super-secret-webhook-key-here

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
